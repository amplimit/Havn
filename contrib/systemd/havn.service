# Reference systemd unit for the havn gateway.
#
# install.sh copies it to /usr/local/lib/systemd/system/havn.service; it is
# not enabled. Put local changes in a drop-in (`systemctl edit havn`) so a
# re-install does not overwrite them. To use it, as root:
#
#   install -d -m 700 -o root -g root /etc/havn
#   install -m 600 -o root -g root /dev/null /etc/havn/havn.env
#   $EDITOR /etc/havn/havn.env          # add: HAVN_AGE_KEY='<passphrase>'
#   HOME=/root havn setup --non-interactive   # once; install.sh does this
#   systemctl enable --now havn
#   journalctl -u havn -f
#
# Write the key with an editor rather than `echo`, which leaves it in the
# shell history. systemd reads the value inside the single quotes literally;
# it must not contain `'` or `\`.

[Unit]
Description=havn gateway
Documentation=https://github.com/amplimit/havn
# The gateway finds the host's outbound interface for agent NAT at startup.
Wants=network-online.target
After=network-online.target
# Stop retrying after five failed starts in five minutes (e.g. a bad config).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Runs as root: agent namespaces, the per-agent cgroups and the NAT rules
# need it.
ExecStart=/usr/local/bin/havn-gateway
# Same config and data paths as `havn setup` run by root with HOME=/root
# (/root/.config/havn/config.toml, /root/.local/share/havn). Set HAVN_CONFIG
# in the environment file to use another config file.
Environment=HOME=/root
# HAVN_AGE_KEY='...' (and any other HAVN_* settings), one per line. Mode
# 0600, owned by root.
EnvironmentFile=/etc/havn/havn.env
# Agent cgroups are /sys/fs/cgroup/havn/agent-<id>: the gateway, as root,
# creates that top-level cgroup and moves agents into it, outside this
# unit's subtree. That is not what systemd delegation covers (a delegated
# service only manages the cgroups below its own); here Delegate=yes only
# makes systemd keep the cpu, memory and pids controllers enabled on the
# path from the root cgroup. "havn" is not a unit name, so systemd leaves
# the cgroup alone. Older gateways used /sys/fs/cgroup/havn.slice; the
# gateway removes what they left there when it starts.
Delegate=yes
# Stopping the unit does not signal the agents (they are outside its
# cgroup); each agent exits when its connection to the gateway closes.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
